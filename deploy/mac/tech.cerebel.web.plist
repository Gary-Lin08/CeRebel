<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by deploy/mac/setup-mac.sh to ~/Library/LaunchAgents. The CeRebel web app on
     127.0.0.1:8092: starts at login, restarts if it stops. Logs: @LOG_DIR@/web.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>tech.cerebel.web</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@APP_DIR@/deploy/mac/start-mac.sh</string></array>
  <key>WorkingDirectory</key><string>@APP_DIR@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CEREBEL_LAYOUT_ENV</key><string>@LAYOUT_FILE@</string>
    <key>CEREBEL_OSIM_MODELS</key><string>@OSIM_MODELS_DIR@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>Umask</key><integer>23</integer>
  <key>StandardOutPath</key><string>@LOG_DIR@/web.log</string>
  <key>StandardErrorPath</key><string>@LOG_DIR@/web.log</string>
</dict>
</plist>
