+def _detect_primary_no_track(
+    frames: np.ndarray,
+    detector,
+    *,
+    batch_size: int = 16,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Per-frame best YOLO box (no ByteTrack), with gap interpolation."""
+    from tqdm import tqdm
+
+    T, H, W, _ = frames.shape
+    bbx_xyxy = np.zeros((T, 4), dtype=np.float32)
+    track_ids = np.full(T, -1, dtype=np.int32)
+
+    def _pick(boxes: np.ndarray, scores: np.ndarray) -> np.ndarray | None:
+        if boxes is None or len(boxes) == 0:
+            return None
+        return boxes[int(np.argmax(scores))]
+
+    if hasattr(detector, "detect_batch"):
+        for start in tqdm(range(0, T, batch_size), desc="YOLOX(batch,no-track)"):
+            chunk = frames[start : start + batch_size]
+            imgs_bgr = [f[..., ::-1].copy() for f in chunk]
+            boxes_list, scores_list = _detect_batch_with_oom_backoff(
+                detector, imgs_bgr, batch_size
+            )
+            for i, (boxes, scores) in enumerate(zip(boxes_list, scores_list)):
+                t = start + i
+                box = _pick(boxes, scores)
+                if box is not None:
+                    bbx_xyxy[t] = box
+                    track_ids[t] = 0
+    else:
+        for t in tqdm(range(T), desc="YOLOX(no-track)"):
+            boxes, scores = detector.detect(frames[t][..., ::-1].copy())
+            box = _pick(boxes, scores)
+            if box is not None:
+                bbx_xyxy[t] = box
+                track_ids[t] = 0
+
+    if (track_ids == 0).sum() == 0:
+        default = np.array([0.0, 0.0, W - 1, H - 1], dtype=np.float32)
+        return np.tile(default, (T, 1)), np.full(T, -1, dtype=np.int32)
+
+    _interpolate_gaps(bbx_xyxy, track_ids, 0, H, W)
+    bbx_xyxy[:, [0, 2]] = np.clip(bbx_xyxy[:, [0, 2]], 0, W - 1)
+    bbx_xyxy[:, [1, 3]] = np.clip(bbx_xyxy[:, [1, 3]], 0, H - 1)
+    return bbx_xyxy, track_ids
+
+
+def _detect_batch_with_oom_backoff(detector, imgs_bgr, batch_size: int):
+    """Run detect_batch, splitting on CUDA OOM."""
+    import torch
+
+    bs = max(1, min(batch_size, len(imgs_bgr)))
+    while bs >= 1:
+        try:
+            # Process in chunks of bs
+            all_boxes, all_scores = [], []
+            for start in range(0, len(imgs_bgr), bs):
+                chunk = imgs_bgr[start : start + bs]
+                boxes_list, scores_list = detector.detect_batch(chunk)
+                all_boxes.extend(boxes_list)
+                all_scores.extend(scores_list)
+            return all_boxes, all_scores
+        except torch.cuda.OutOfMemoryError:
+            torch.cuda.empty_cache()
+            if bs == 1:
+                raise
+            bs = max(1, bs // 2)
+    raise RuntimeError("YOLO detect_batch failed")
+
+
