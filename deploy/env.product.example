# Copy to /root/CerebelServer/.env.product on the server and fill in. Never commit the real file.

# --- web app
MOTION_AGENT_HOST=127.0.0.1          # keep on localhost; publish it through an HTTPS tunnel (see LAUNCH.md)
MOTION_AGENT_PORT=8092
CEREBEL_DATA_DIR=/root/CerebelServer/data
CEREBEL_PUBLIC_URL=https://app.example.com   # the public HTTPS address users open
CEREBEL_ALLOWED_ORIGINS=                      # leave empty: the UI is served from the same origin
CEREBEL_TOKEN_TTL_DAYS=30
CEREBEL_UPLOAD_MAX_BYTES=314572800            # 300 MB

# --- plans
CEREBEL_FREE_MONTHLY=3
CEREBEL_PRO_MONTHLY=60
CEREBEL_FOUNDING_LIMIT=200

# --- Stripe (live keys only on the server)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=                         # leave empty to hide the monthly plan
STRIPE_FOUNDING_COUPON=                       # coupon that makes the first year $69

# --- legal pages
CEREBEL_LEGAL_ENTITY='Cerebel, Inc.'          # exact legal name of the Delaware C-corp
CEREBEL_SUPPORT_EMAIL=

# --- coach (language model): use a US-hosted OpenAI-compatible endpoint
# Same model as today (Qwen3.7-Plus) is served in the US by Together AI or Fireworks.
MOTION_AGENT_BACKEND=dashscope                # name is historical; it is a generic OpenAI-compatible client
MOTION_AGENT_BASE_URL=                        # e.g. https://api.together.xyz/v1 or https://api.fireworks.ai/inference/v1
MOTION_AGENT_MODEL=                           # the provider's model id for Qwen3.7-Plus
MOTION_AGENT_API_KEY=                         # provider API key (server only)
MOTION_AGENT_ENABLE_THINKING=0                # 0 = no reasoning tokens: cheaper and faster; set 1 if answers get worse
CEREBEL_LLM_ATTACH_VIDEO=0                    # 0 = never send video frames to the model
MOTION_AGENT_MAX_TOOL_CALLS=12                # cost cap per question
MOTION_AGENT_KB_EMBED_MODEL=                  # an embedding model the provider serves
MOTION_AGENT_KB_EMBED_BASE_URL=               # leave empty to use MOTION_AGENT_BASE_URL
MOTION_AGENT_KB_INDEX_DIR=/root/CerebelServer/data/kb_index_us   # new dir so the index is rebuilt with the new embedder

# --- coach question limits per day (cost guard)
CEREBEL_ANON_DAILY_QUESTIONS=3
CEREBEL_FREE_DAILY_QUESTIONS=15
CEREBEL_PRO_DAILY_QUESTIONS=100

# --- GPU pipeline
CEREBEL_MOBL_ARMS=0                           # MoBL-ARMS arm model is licensed for non-commercial use only
CEREBEL_DEMO_SESSION_ID=                      # the one session anonymous visitors may view

# --- operator tools (keep secret, long and random)
MOTION_AGENT_PROMPT_PASSWORD=

# --- GPU backend
CEREBEL_GPU_BACKEND=local                     # local = warm worker on this machine; modal = deploy/modal_gemx.py
CEREBEL_QUEUE_WORKERS=                        # parallel jobs; default 1 (local) or 10 (modal)
CEREBEL_AVG_JOB_SECONDS=150                   # used for the "about N min" estimate; update from real logs
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET come from `modal token new` when using the modal backend

# --- "your analysis is ready" emails (SpaceMail SMTP works: mail.spacemail.com, port 465)
CEREBEL_SMTP_HOST=
CEREBEL_SMTP_PORT=465
CEREBEL_SMTP_USER=
CEREBEL_SMTP_PASSWORD=
CEREBEL_MAIL_FROM=CeRebel <garylin@cerebel.tech>
