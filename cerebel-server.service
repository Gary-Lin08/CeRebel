[Unit]
Description=CeRebel Playground capture server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/CerebelServer
Environment=CEREBEL_HOST=0.0.0.0
Environment=CEREBEL_PORT=61016
Environment=CEREBEL_DATA_DIR=/root/CerebelServer/data
Environment=CEREBEL_GEMX_ROOT=/root/GEM-X
Environment=CEREBEL_GEMX_PYTHON=/root/GEM-X/.venv/bin/python
Environment=CEREBEL_GEMX_ENABLED=1
Environment=CEREBEL_GEMX_WORKER_HOST=127.0.0.1
Environment=CEREBEL_GEMX_WORKER_PORT=61017
Environment=CEREBEL_VISER_HOST=127.0.0.1
Environment=CEREBEL_VISER_PORT=8090
Environment=CEREBEL_KINETIC_LENS_HOST=127.0.0.1
Environment=CEREBEL_KINETIC_LENS_PORT=8091
Environment=CEREBEL_IK_ENABLED=1
Environment=CEREBEL_IK_PYTHON=/root/CerebelServer/.venv-ik/bin/python
ExecStartPre=-/bin/bash -c 'for p in $(pgrep -f /root/CerebelServer/kinetic_lens_viewer.py || true); do kill $p; done; for p in $(pgrep -f /root/CerebelServer/mesh_viewer_service.py || true); do kill $p; done; for p in $(pgrep -f /root/CerebelServer/gemx_warm_worker.py || true); do kill $p; done; true'
ExecStartPre=/bin/bash -c '/root/GEM-X/.venv/bin/python -u /root/CerebelServer/gemx_warm_worker.py >> /root/CerebelServer/gemx_worker.log 2>&1 < /dev/null &'
ExecStartPre=/bin/bash -c '/root/GEM-X/.venv/bin/python -u /root/CerebelServer/mesh_viewer_service.py >> /root/CerebelServer/mesh_viewer.log 2>&1 < /dev/null &'
ExecStartPre=/bin/bash -c '/root/CerebelServer/.venv/bin/python -u /root/CerebelServer/kinetic_lens_viewer.py >> /root/CerebelServer/kinetic_lens.log 2>&1 < /dev/null &'
ExecStart=/root/CerebelServer/.venv/bin/python -u /root/CerebelServer/server.py
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
