{
  "name": "@cerebel/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Cerebel motion-analysis API, with the Cerebel AI glasses link protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3"
  }
}
